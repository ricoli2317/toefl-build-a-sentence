      "questionId": "reading-rdl-5c4606d16cf712944122c4b1-q01",
      "logicalItemId": "reading-rdl-5c4606d16cf712944122c4b1",
      "questionOrder": 1,
      "questionType": "rdl",
      "stem": "What should be done first to reset the router?",
      "rawDisplayText": "21. What should be done first to reset the router?",
      "payload": {
        "materialId": "RDL-020",
        "options": [
          {
            "optionId": "reading-rdl-5c4606d16cf712944122c4b1-q01-opt-1",
            "optionOrder": 1,
            "text": "Disconnect the router from electrical power"
          },
          {
            "optionId": "reading-rdl-5c4606d16cf712944122c4b1-q01-opt-2",
            "optionOrder": 2,
            "text": "Wait for the router to restart automatically"
          },
          {
            "optionId": "reading-rdl-5c4606d16cf712944122c4b1-q01-opt-3",
            "optionOrder": 3,
            "text": "Wait for 30 seconds for the router to cool"
          },
          {
            "optionId": "reading-rdl-5c4606d16cf712944122c4b1-q01-opt-4",
            "optionOrder": 4,
            "text": "Plug the router back in and push the start button"
          }
        ],
        "correctOptionId": "reading-rdl-5c4606d16cf712944122c4b1-q01-opt-1"
      }
    },
    {
      "questionId": "reading-rdl-5c4606d16cf712944122c4b1-q02",
      "logicalItemId": "reading-rdl-5c4606d16cf712944122c4b1",
      "questionOrder": 2,
      "questionType": "rdl",
      "stem": "What is the final step to resetting the router?",
      "rawDisplayText": "22. What is the final step to resetting the router?",
      "payload": {
        "materialId": "RDL-020",
        "options": [
          {
            "optionId": "reading-rdl-5c4606d16cf712944122c4b1-q02-opt-1",
            "optionOrder": 1,
            "text": "Unplug the router from the power source"
          },
          {
            "optionId": "reading-rdl-5c4606d16cf712944122c4b1-q02-opt-2",
            "optionOrder": 2,
            "text": "Wait until the router has completely started again"
          },
          {
            "optionId": "reading-rdl-5c4606d16cf712944122c4b1-q02-opt-3",
            "optionOrder": 3,
            "text": "Plug the router into a different power source"
          },
          {
            "optionId": "reading-rdl-5c4606d16cf712944122c4b1-q02-opt-4",
            "optionOrder": 4,
            "text": "Wait for 30 seconds or until the light flashes"
          }
        ],
        "correctOptionId": "reading-rdl-5c4606d16cf712944122c4b1-q02-opt-2"
      }
    }
  ]
