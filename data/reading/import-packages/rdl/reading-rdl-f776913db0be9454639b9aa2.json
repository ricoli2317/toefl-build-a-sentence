      "questionType": "rdl",
      "stem": "Where can students check out and return books during the renovation?",
      "rawDisplayText": "23. Where can students check out and return books during the renovation?",
      "payload": {
        "materialId": "RDL-041",
        "options": [
          {
            "optionId": "reading-rdl-f776913db0be9454639b9aa2-q01-opt-1",
            "optionOrder": 1,
            "text": "In the Main Building"
          },
          {
            "optionId": "reading-rdl-f776913db0be9454639b9aa2-q01-opt-2",
            "optionOrder": 2,
            "text": "In the Meyer Student Union Building"
          },
          {
            "optionId": "reading-rdl-f776913db0be9454639b9aa2-q01-opt-3",
            "optionOrder": 3,
            "text": "In the Frankson Library"
          },
          {
            "optionId": "reading-rdl-f776913db0be9454639b9aa2-q01-opt-4",
            "optionOrder": 4,
            "text": "On the Main Quad"
          }
        ],
        "correctOptionId": "reading-rdl-f776913db0be9454639b9aa2-q01-opt-2"
      }
    },
    {
      "questionId": "reading-rdl-f776913db0be9454639b9aa2-q02",
      "logicalItemId": "reading-rdl-f776913db0be9454639b9aa2",
      "questionOrder": 2,
      "questionType": "rdl",
      "stem": "What does the notice imply about the university’s digital resources?",
      "rawDisplayText": "24. What does the notice imply about the university’s digital resources?",
      "payload": {
        "materialId": "RDL-041",
        "options": [
          {
            "optionId": "reading-rdl-f776913db0be9454639b9aa2-q02-opt-1",
            "optionOrder": 1,
            "text": "They can be accessed only during the temporary library’s operating hours."
          },
          {
            "optionId": "reading-rdl-f776913db0be9454639b9aa2-q02-opt-2",
            "optionOrder": 2,
            "text": "They may compensate for reduced convenience during the renovation."
          },
          {
            "optionId": "reading-rdl-f776913db0be9454639b9aa2-q02-opt-3",
            "optionOrder": 3,
            "text": "They were developed specifically in response to the renovation project."
          },
          {
            "optionId": "reading-rdl-f776913db0be9454639b9aa2-q02-opt-4",
            "optionOrder": 4,
            "text": "They will be accessible only to students who register through the online portal."
          }
        ],
        "correctOptionId": "reading-rdl-f776913db0be9454639b9aa2-q02-opt-2"
      }
    },
    {
      "questionId": "reading-rdl-f776913db0be9454639b9aa2-q03",
      "logicalItemId": "reading-rdl-f776913db0be9454639b9aa2",
      "questionOrder": 3,
      "questionType": "rdl",
      "stem": "What can be inferred from the notice about the Meyer Student Union Building?",
      "rawDisplayText": "25. What can be inferred from the notice about the Meyer Student Union Building?",
      "payload": {
        "materialId": "RDL-041",
        "options": [
          {
            "optionId": "reading-rdl-f776913db0be9454639b9aa2-q03-opt-1",
            "optionOrder": 1,
            "text": "It is not close to the university’s Main Building."
          },
          {
            "optionId": "reading-rdl-f776913db0be9454639b9aa2-q03-opt-2",
            "optionOrder": 2,
            "text": "It is the only campus building large enough to house library services."
          },
          {
            "optionId": "reading-rdl-f776913db0be9454639b9aa2-q03-opt-3",
            "optionOrder": 3,
            "text": "It is not within easy walking distance of the Main Quad."
          },
          {
            "optionId": "reading-rdl-f776913db0be9454639b9aa2-q03-opt-4",
            "optionOrder": 4,
            "text": "It does not normally offer study spaces for students."
          }
        ],
        "correctOptionId": "reading-rdl-f776913db0be9454639b9aa2-q03-opt-3"
      }
    }
