          {
            "optionId": "reading-rdl-98e360bf3b87450aaef50862-q03-opt-1",
            "optionOrder": 1,
            "text": "It can be postponed to a different day by calling the maintenance department."
          },
          {
            "optionId": "reading-rdl-98e360bf3b87450aaef50862-q03-opt-2",
            "optionOrder": 2,
            "text": "It is required for infrastructure upgrades."
          },
          {
            "optionId": "reading-rdl-98e360bf3b87450aaef50862-q03-opt-3",
            "optionOrder": 3,
            "text": "It will occur weekly."
          },
          {
            "optionId": "reading-rdl-98e360bf3b87450aaef50862-q03-opt-4",
