          {
            "optionId": "reading-rdl-1d890dd246a10beef9c98c91-q01-opt-2",
            "optionOrder": 2,
            "text": "It features the largest central square in northern Europe."
          },
          {
            "optionId": "reading-rdl-1d890dd246a10beef9c98c91-q01-opt-3",
            "optionOrder": 3,
            "text": "It is famous for its art museums."
          },
          {
            "optionId": "reading-rdl-1d890dd246a10beef9c98c91-q01-opt-4",
            "optionOrder": 4,
            "text": "It is an area where locals wear traditional attire."
          }
