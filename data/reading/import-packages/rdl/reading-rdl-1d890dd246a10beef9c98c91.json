      "stem": "What makes Tallinn's Old Town a significant attraction in Estonia?",
      "rawDisplayText": "25. What makes Tallinn's Old Town a significant attraction in Estonia?",
      "payload": {
        "materialId": "RDL-076",
        "options": [
          {
            "optionId": "reading-rdl-1d890dd246a10beef9c98c91-q01-opt-1",
            "optionOrder": 1,
            "text": "It is recognized by UNESCO for its old architecture."
