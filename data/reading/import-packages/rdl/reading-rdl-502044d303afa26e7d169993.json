      "stem": "What is the main topic of the article?",
      "rawDisplayText": "23. What is the main topic of the article?",
      "payload": {
        "materialId": "RDL-052",
        "options": [
          {
            "optionId": "reading-rdl-502044d303afa26e7d169993-q01-opt-1",
            "optionOrder": 1,
            "text": "The discovery of artifacts left by previous students"
          },
          {
            "optionId": "reading-rdl-502044d303afa26e7d169993-q01-opt-2",
            "optionOrder": 2,
            "text": "The ending of a beloved campus tradition"
          },
          {
            "optionId": "reading-rdl-502044d303afa26e7d169993-q01-opt-3",
            "optionOrder": 3,
            "text": "The renovation of a student residence hall"
          },
          {
            "optionId": "reading-rdl-502044d303afa26e7d169993-q01-opt-4",
            "optionOrder": 4,
            "text": "The nostalgia over past hopes and dreams"
          }
        ],
        "correctOptionId": "reading-rdl-502044d303afa26e7d169993-q01-opt-1"
      }
    },
    {
      "questionId": "reading-rdl-502044d303afa26e7d169993-q02",
      "logicalItemId": "reading-rdl-502044d303afa26e7d169993",
      "questionOrder": 2,
      "questionType": "rdl",
      "stem": "What is indicated about the time capsule itself?",
      "rawDisplayText": "24. What is indicated about the time capsule itself?",
      "payload": {
        "materialId": "RDL-052",
        "options": [
          {
            "optionId": "reading-rdl-502044d303afa26e7d169993-q02-opt-1",
            "optionOrder": 1,
            "text": "It relied on twentieth-century technology."
          },
          {
            "optionId": "reading-rdl-502044d303afa26e7d169993-q02-opt-2",
            "optionOrder": 2,
            "text": "It was buried more than a century ago."
          },
          {
            "optionId": "reading-rdl-502044d303afa26e7d169993-q02-opt-3",
            "optionOrder": 3,
            "text": "It was empty when it was opened."
          },
          {
            "optionId": "reading-rdl-502044d303afa26e7d169993-q02-opt-4",
            "optionOrder": 4,
            "text": "Its contents were damaged."
          }
        ],
        "correctOptionId": "reading-rdl-502044d303afa26e7d169993-q02-opt-2"
      }
    },
    {
      "questionId": "reading-rdl-502044d303afa26e7d169993-q03",
      "logicalItemId": "reading-rdl-502044d303afa26e7d169993",
      "questionOrder": 3,
      "questionType": "rdl",
      "stem": "How did current students react to the discovery of the capsule?",
      "rawDisplayText": "25. How did current students react to the discovery of the capsule?",
      "payload": {
        "materialId": "RDL-052",
        "options": [
          {
            "optionId": "reading-rdl-502044d303afa26e7d169993-q03-opt-1",
            "optionOrder": 1,
            "text": "They showed little interest in the discovery."
          },
          {
            "optionId": "reading-rdl-502044d303afa26e7d169993-q03-opt-2",
            "optionOrder": 2,
            "text": "They criticized the plan for the exhibition."
          },
          {
            "optionId": "reading-rdl-502044d303afa26e7d169993-q03-opt-3",
            "optionOrder": 3,
            "text": "They were inspired to imitate the students of 1896."
          },
          {
            "optionId": "reading-rdl-502044d303afa26e7d169993-q03-opt-4",
            "optionOrder": 4,
            "text": "They insisted that it be reburied."
          }
        ],
        "correctOptionId": "reading-rdl-502044d303afa26e7d169993-q03-opt-3"
      }
    }
