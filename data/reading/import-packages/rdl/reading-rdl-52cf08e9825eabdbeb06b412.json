      "questionId": "reading-rdl-52cf08e9825eabdbeb06b412-q01",
      "logicalItemId": "reading-rdl-52cf08e9825eabdbeb06b412",
      "questionOrder": 1,
      "questionType": "rdl",
      "stem": "What does the notice indicate about the fall midterm exam schedule?",
      "rawDisplayText": "21. What does the notice indicate about the fall midterm exam schedule?",
      "payload": {
        "materialId": "RDL-007",
        "options": [
          {
            "optionId": "reading-rdl-52cf08e9825eabdbeb06b412-q01-opt-1",
            "optionOrder": 1,
            "text": "Some academic divisions will start giving exams on October 1."
          },
          {
            "optionId": "reading-rdl-52cf08e9825eabdbeb06b412-q01-opt-2",
            "optionOrder": 2,
            "text": "Some science courses have a later exam slot than other science courses."
          },
          {
            "optionId": "reading-rdl-52cf08e9825eabdbeb06b412-q01-opt-3",
            "optionOrder": 3,
            "text": "To find exam location information, students must go online."
          },
          {
            "optionId": "reading-rdl-52cf08e9825eabdbeb06b412-q01-opt-4",
            "optionOrder": 4,
            "text": "Exam date information must be requested from the professor."
          }
        ],
        "correctOptionId": "reading-rdl-52cf08e9825eabdbeb06b412-q01-opt-2"
      }
    },
    {
      "questionId": "reading-rdl-52cf08e9825eabdbeb06b412-q02",
      "logicalItemId": "reading-rdl-52cf08e9825eabdbeb06b412",
      "questionOrder": 2,
      "questionType": "rdl",
      "stem": "A student has a lab course midterm and an engineering midterm scheduled on the same day. According to the notice, what is she required to do?",
      "rawDisplayText": "22. A student has a lab course midterm and an engineering midterm scheduled on the same day. According to the notice, what is she required to do?",
      "payload": {
        "materialId": "RDL-007",
        "options": [
          {
            "optionId": "reading-rdl-52cf08e9825eabdbeb06b412-q02-opt-1",
            "optionOrder": 1,
            "text": "Ask her engineering professor to move the exam to another day"
          },
          {
            "optionId": "reading-rdl-52cf08e9825eabdbeb06b412-q02-opt-2",
            "optionOrder": 2,
            "text": "Inform the Registrar of the situation no later than October 1"
          },
          {
            "optionId": "reading-rdl-52cf08e9825eabdbeb06b412-q02-opt-3",
            "optionOrder": 3,
            "text": "Ask her science professor for permission to start her exam early"
          },
          {
            "optionId": "reading-rdl-52cf08e9825eabdbeb06b412-q02-opt-4",
            "optionOrder": 4,
            "text": "Inform the science and engineering divisions by October 20"
          }
        ],
        "correctOptionId": "reading-rdl-52cf08e9825eabdbeb06b412-q02-opt-2"
      }
    }
  ]
