    {
      "questionId": "reading-rdl-5477133100b2982be0a02471-q01",
      "logicalItemId": "reading-rdl-5477133100b2982be0a02471",
      "questionOrder": 1,
      "questionType": "rdl",
      "stem": "According to the article, what philosophical perspective does kintsugi promote?",
      "rawDisplayText": "28. According to the article, what philosophical perspective does kintsugi promote?",
      "payload": {
        "materialId": "RDL-085",
        "options": [
          {
            "optionId": "reading-rdl-5477133100b2982be0a02471-q01-opt-1",
            "optionOrder": 1,
            "text": "Minimalism, emphasizing simplicity and the elimination of excess"
          },
          {
            "optionId": "reading-rdl-5477133100b2982be0a02471-q01-opt-2",
            "optionOrder": 2,
            "text": "Ethics, focusing on honor and discipline in craftsmanship"
          },
          {
            "optionId": "reading-rdl-5477133100b2982be0a02471-q01-opt-3",
            "optionOrder": 3,
            "text": "Humility, valuing imperfection and the transient nature of life"
          },
          {
            "optionId": "reading-rdl-5477133100b2982be0a02471-q01-opt-4",
            "optionOrder": 4,
            "text": "Purity, highlighting spiritual cleanliness and ritual renewal"
          }
        ],
        "correctOptionId": "reading-rdl-5477133100b2982be0a02471-q01-opt-3"
      }
    },
    {
      "questionId": "reading-rdl-5477133100b2982be0a02471-q02",
      "logicalItemId": "reading-rdl-5477133100b2982be0a02471",
      "questionOrder": 2,
      "questionType": "rdl",
      "stem": "What does the article suggest about the symbolic meaning of repairing pottery with precious metals?",
      "rawDisplayText": "29. What does the article suggest about the symbolic meaning of repairing pottery with precious metals?",
      "payload": {
        "materialId": "RDL-085",
        "options": [
          {
            "optionId": "reading-rdl-5477133100b2982be0a02471-q02-opt-1",
            "optionOrder": 1,
            "text": "Wealth and luxury are essential for authentic art."
          },
          {
            "optionId": "reading-rdl-5477133100b2982be0a02471-q02-opt-2",
            "optionOrder": 2,
            "text": "Flaws can be turned into sources of value and beauty."
          },
          {
            "optionId": "reading-rdl-5477133100b2982be0a02471-q02-opt-3",
            "optionOrder": 3,
            "text": "Artisans prioritize aesthetics over philosophical significance."
          },
          {
            "optionId": "reading-rdl-5477133100b2982be0a02471-q02-opt-4",
            "optionOrder": 4,
            "text": "Objects lose their cultural value when restored with cheap materials."
          }
        ],
        "correctOptionId": "reading-rdl-5477133100b2982be0a02471-q02-opt-2"
      }
    },
    {
      "questionId": "reading-rdl-5477133100b2982be0a02471-q03",
      "logicalItemId": "reading-rdl-5477133100b2982be0a02471",
      "questionOrder": 3,
      "questionType": "rdl",
      "stem": "Why does the author of the article mention \"a perfection-driven world\"?",
      "rawDisplayText": "30. Why does the author of the article mention \"a perfection-driven world\"?",
      "payload": {
        "materialId": "RDL-085",
        "options": [
          {
            "optionId": "reading-rdl-5477133100b2982be0a02471-q03-opt-1",
            "optionOrder": 1,
            "text": "To argue that modern society has completely abandoned traditional art forms"
          },
          {
            "optionId": "reading-rdl-5477133100b2982be0a02471-q03-opt-2",
            "optionOrder": 2,
            "text": "To suggest that flawless craftsmanship is the goal of contemporary design"
          },
          {
            "optionId": "reading-rdl-5477133100b2982be0a02471-q03-opt-3",
            "optionOrder": 3,
            "text": "To contrast kintsugi's philosophical message with a common present-day attitude"
          },
          {
            "optionId": "reading-rdl-5477133100b2982be0a02471-q03-opt-4",
            "optionOrder": 4,
            "text": "To explain why kintsugi techniques are rarely used in professional pottery today"
          }
        ],
        "correctOptionId": "reading-rdl-5477133100b2982be0a02471-q03-opt-3"
      }
    }
  ]
