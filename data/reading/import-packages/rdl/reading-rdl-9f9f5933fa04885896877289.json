      "logicalItemId": "reading-rdl-9f9f5933fa04885896877289",
      "questionOrder": 1,
      "questionType": "rdl",
      "stem": "All of the following are true of the new nuclear reactor EXCEPT",
      "rawDisplayText": "23. All of the following are true of the new nuclear reactor EXCEPT",
      "payload": {
        "materialId": "RDL-079",
        "options": [
          {
            "optionId": "reading-rdl-9f9f5933fa04885896877289-q01-opt-1",
            "optionOrder": 1,
            "text": "It is about the size of a classroom."
          },
          {
            "optionId": "reading-rdl-9f9f5933fa04885896877289-q01-opt-2",
            "optionOrder": 2,
            "text": "It is located on the engineering quad."
          },
          {
            "optionId": "reading-rdl-9f9f5933fa04885896877289-q01-opt-3",
            "optionOrder": 3,
            "text": "Its purpose is to provide power to the university."
          },
          {
            "optionId": "reading-rdl-9f9f5933fa04885896877289-q01-opt-4",
            "optionOrder": 4,
            "text": "It has caused safety concerns among students."
          }
        ],
        "correctOptionId": "reading-rdl-9f9f5933fa04885896877289-q01-opt-3"
      }
    },
    {
      "questionId": "reading-rdl-9f9f5933fa04885896877289-q02",
      "logicalItemId": "reading-rdl-9f9f5933fa04885896877289",
      "questionOrder": 2,
      "questionType": "rdl",
      "stem": "What claim does the project lead make regarding the safety of the new reactor?",
      "rawDisplayText": "24. What claim does the project lead make regarding the safety of the new reactor?",
      "payload": {
        "materialId": "RDL-079",
        "options": [
          {
            "optionId": "reading-rdl-9f9f5933fa04885896877289-q02-opt-1",
            "optionOrder": 1,
            "text": "It exposes passersby to less radiation than they would receive on an airplane."
          },
          {
            "optionId": "reading-rdl-9f9f5933fa04885896877289-q02-opt-2",
            "optionOrder": 2,
            "text": "It will provide opportunities for the university that override worries about safety."
          },
          {
            "optionId": "reading-rdl-9f9f5933fa04885896877289-q02-opt-3",
            "optionOrder": 3,
            "text": "It is safer for students than are the industrial reactors located near campus."
          },
          {
            "optionId": "reading-rdl-9f9f5933fa04885896877289-q02-opt-4",
            "optionOrder": 4,
            "text": "It is low-power, heavily shielded, and monitored under strict federal guidelines."
          }
        ],
        "correctOptionId": "reading-rdl-9f9f5933fa04885896877289-q02-opt-1"
      }
    },
    {
