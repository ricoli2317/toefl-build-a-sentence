      "questionType": "rdl",
      "stem": "What is the general aim of the Study Abroad Expo?",
      "rawDisplayText": "28. What is the general aim of the Study Abroad Expo?",
      "payload": {
        "materialId": "RDL-045",
        "options": [
          {
            "optionId": "reading-rdl-c849d537afb39dac106e67a6-q01-opt-1",
            "optionOrder": 1,
            "text": "To evaluate emerging risks in a variety of sectors in the field of global education"
          },
          {
            "optionId": "reading-rdl-c849d537afb39dac106e67a6-q01-opt-2",
            "optionOrder": 2,
            "text": "To facilitate a deep understanding of opportunities for international learning"
          },
          {
            "optionId": "reading-rdl-c849d537afb39dac106e67a6-q01-opt-3",
            "optionOrder": 3,
            "text": "To highlight the historical significance of student exchange programs"
          },
          {
            "optionId": "reading-rdl-c849d537afb39dac106e67a6-q01-opt-4",
            "optionOrder": 4,
            "text": "To promote the sale of travel-related merchandise intended for students"
          }
        ],
        "correctOptionId": "reading-rdl-c849d537afb39dac106e67a6-q01-opt-2"
      }
    },
    {
      "questionId": "reading-rdl-c849d537afb39dac106e67a6-q02",
      "logicalItemId": "reading-rdl-c849d537afb39dac106e67a6",
      "questionOrder": 2,
      "questionType": "rdl",
      "stem": "What is suggested about the Sustainable Study Abroad panel?",
      "rawDisplayText": "29. What is suggested about the Sustainable Study Abroad panel?",
      "payload": {
        "materialId": "RDL-045",
        "options": [
          {
            "optionId": "reading-rdl-c849d537afb39dac106e67a6-q02-opt-1",
            "optionOrder": 1,
            "text": "It will mainly address the costs of studying abroad for students."
          },
          {
            "optionId": "reading-rdl-c849d537afb39dac106e67a6-q02-opt-2",
            "optionOrder": 2,
            "text": "It will show the need to integrate eco-friendly practices into study abroad programs."
          },
          {
            "optionId": "reading-rdl-c849d537afb39dac106e67a6-q02-opt-3",
            "optionOrder": 3,
            "text": "It will examine the impact of studying abroad on student environmental consciousness."
          },
          {
            "optionId": "reading-rdl-c849d537afb39dac106e67a6-q02-opt-4",
            "optionOrder": 4,
            "text": "It will primarily focus on the legal aspects of participating in study abroad programs."
          }
        ],
        "correctOptionId": "reading-rdl-c849d537afb39dac106e67a6-q02-opt-2"
      }
    },
