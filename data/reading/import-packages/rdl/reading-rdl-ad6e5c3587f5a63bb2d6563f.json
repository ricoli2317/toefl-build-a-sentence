      "questionOrder": 1,
      "questionType": "rdl",
      "stem": "What is indicated about the skills students will develop from taking the CULN 310 course?",
      "rawDisplayText": "28. What is indicated about the skills students will develop from taking the CULN 310 course?",
      "payload": {
        "materialId": "RDL-084",
        "options": [
          {
            "optionId": "reading-rdl-ad6e5c3587f5a63bb2d6563f-q01-opt-1",
            "optionOrder": 1,
            "text": "They will gain expertise in general culinary management techniques."
          },
          {
            "optionId": "reading-rdl-ad6e5c3587f5a63bb2d6563f-q01-opt-2",
            "optionOrder": 2,
            "text": "They will become proficient in the use of a technically complex cooking technique."
          },
          {
            "optionId": "reading-rdl-ad6e5c3587f5a63bb2d6563f-q01-opt-3",
            "optionOrder": 3,
            "text": "They will learn to critique historical culinary trends as restaurant critics."
          },
          {
            "optionId": "reading-rdl-ad6e5c3587f5a63bb2d6563f-q01-opt-4",
            "optionOrder": 4,
            "text": "They will become experts in the practical applications of plant-based ingredients."
          }
        ],
        "correctOptionId": "reading-rdl-ad6e5c3587f5a63bb2d6563f-q01-opt-2"
      }
    },
    {
      "questionId": "reading-rdl-ad6e5c3587f5a63bb2d6563f-q02",
      "logicalItemId": "reading-rdl-ad6e5c3587f5a63bb2d6563f",
      "questionOrder": 2,
      "questionType": "rdl",
      "stem": "What is indicated about the eligibility criteria for enrolling in CULN 310?",
      "rawDisplayText": "29. What is indicated about the eligibility criteria for enrolling in CULN 310?",
      "payload": {
        "materialId": "RDL-084",
        "options": [
          {
            "optionId": "reading-rdl-ad6e5c3587f5a63bb2d6563f-q02-opt-1",
            "optionOrder": 1,
            "text": "Enrollment is open to all students with an interest in gastronomic science."
          },
          {
            "optionId": "reading-rdl-ad6e5c3587f5a63bb2d6563f-q02-opt-2",
            "optionOrder": 2,
            "text": "Admission requires an advanced understanding of the sous vide technique."
          },
          {
            "optionId": "reading-rdl-ad6e5c3587f5a63bb2d6563f-q02-opt-3",
            "optionOrder": 3,
            "text": "Candidates must have completed two introductory courses in the department."
          },
          {
            "optionId": "reading-rdl-ad6e5c3587f5a63bb2d6563f-q02-opt-4",
            "optionOrder": 4,
            "text": "Students are required to possess prior work experience in an industrial kitchen."
          }
        ],
        "correctOptionId": "reading-rdl-ad6e5c3587f5a63bb2d6563f-q02-opt-3"
      }
    },
    {
