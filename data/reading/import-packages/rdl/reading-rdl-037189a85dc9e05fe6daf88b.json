      "questionOrder": 2,
      "questionType": "rdl",
      "stem": "What should residents do beforehand?",
      "rawDisplayText": "24. What should residents do beforehand?",
      "payload": {
        "materialId": "RDL-048",
        "options": [
          {
            "optionId": "reading-rdl-037189a85dc9e05fe6daf88b-q02-opt-1",
            "optionOrder": 1,
            "text": "Plan for power outages"
          },
          {
            "optionId": "reading-rdl-037189a85dc9e05fe6daf88b-q02-opt-2",
            "optionOrder": 2,
            "text": "Disconnect all water appliances"
          },
          {
            "optionId": "reading-rdl-037189a85dc9e05fe6daf88b-q02-opt-3",
            "optionOrder": 3,
            "text": "Inspect faucets and showers for leaks"
          },
          {
            "optionId": "reading-rdl-037189a85dc9e05fe6daf88b-q02-opt-4",
            "optionOrder": 4,
            "text": "Ensure enough water is stored for one day"
          }
        ],
        "correctOptionId": "reading-rdl-037189a85dc9e05fe6daf88b-q02-opt-4"
      }
    },
    {
      "questionId": "reading-rdl-037189a85dc9e05fe6daf88b-q03",
