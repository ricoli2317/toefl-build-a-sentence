  "materials": [],
  "passages": [
    {
      "passageId": "reading-rap-b58232c37a080aa5aad5e9d1-passage-01",
      "logicalItemId": "reading-rap-b58232c37a080aa5aad5e9d1",
      "title": "The Mystery of Dark Galaxies",
      "paragraphs": [
        {
          "paragraphId": "reading-rap-b58232c37a080aa5aad5e9d1-passage-01-p01",
          "paragraphOrder": 1,
          "text": "Ultraviolet (UV) astronomy has unveiled numerous cosmic phenomena. An especially intriguing discovery is that of dark galaxies. Unlike typical galaxies (gravitationally bound systems of stars, gas, and other particles), dark galaxies emit little to no visible light, making them nearly impossible to detect using conventional optical telescopes. However, these galaxies emit UV radiation, providing astronomers with a unique window to study them. Dark galaxies challenge our understanding of galaxy formation. Traditional models suggest that galaxies form through gas accumulation and star formation. But although dark galaxies contain vast amounts of gas, they have few, if any, stars. This raises questions about the processes that inhibit star formation. Some researchers propose that turbulence within the gas clouds might prevent the gas from collapsing to form stars.",
          "rawText": "Ultraviolet (UV) astronomy has unveiled numerous cosmic phenomena. An especially intriguing discovery is that of dark galaxies. Unlike typical galaxies (gravitationally bound systems of stars, gas, and other particles), dark galaxies emit little to no visible light, making them nearly impossible to detect using conventional optical telescopes. However, these galaxies emit UV radiation, providing astronomers with a unique window to study them. ■ Dark galaxies challenge our understanding of galaxy formation. ■ Traditional models suggest that galaxies form through gas accumulation and star formation. ■ But although dark galaxies contain vast amounts of gas, they have few, if any, stars. ■ This raises questions about the processes that inhibit star formation. Some researchers propose that turbulence within the gas clouds might prevent the gas from collapsing to form stars.",
          "sentences": [
            {
              "sentenceId": "reading-rap-b58232c37a080aa5aad5e9d1-passage-01-p01-s01",
              "sentenceOrder": 1,
              "text": "Ultraviolet (UV) astronomy has unveiled numerous cosmic phenomena."
            },
            {
              "sentenceId": "reading-rap-b58232c37a080aa5aad5e9d1-passage-01-p01-s02",
              "sentenceOrder": 2,
              "text": "An especially intriguing discovery is that of dark galaxies."
            },
            {
              "sentenceId": "reading-rap-b58232c37a080aa5aad5e9d1-passage-01-p01-s03",
              "sentenceOrder": 3,
              "text": "Unlike typical galaxies (gravitationally bound systems of stars, gas, and other particles), dark galaxies emit little to no visible light, making them nearly impossible to detect using conventional optical telescopes."
            },
            {
              "sentenceId": "reading-rap-b58232c37a080aa5aad5e9d1-passage-01-p01-s04",
              "sentenceOrder": 4,
              "text": "However, these galaxies emit UV radiation, providing astronomers with a unique window to study them."
            },
            {
              "sentenceId": "reading-rap-b58232c37a080aa5aad5e9d1-passage-01-p01-s05",
              "sentenceOrder": 5,
              "text": "Dark galaxies challenge our understanding of galaxy formation."
            },
            {
              "sentenceId": "reading-rap-b58232c37a080aa5aad5e9d1-passage-01-p01-s06",
              "sentenceOrder": 6,
              "text": "Traditional models suggest that galaxies form through gas accumulation and star formation."
            },
            {
              "sentenceId": "reading-rap-b58232c37a080aa5aad5e9d1-passage-01-p01-s07",
              "sentenceOrder": 7,
              "text": "But although dark galaxies contain vast amounts of gas, they have few, if any, stars."
            },
            {
              "sentenceId": "reading-rap-b58232c37a080aa5aad5e9d1-passage-01-p01-s08",
              "sentenceOrder": 8,
              "text": "This raises questions about the processes that inhibit star formation."
            },
            {
              "sentenceId": "reading-rap-b58232c37a080aa5aad5e9d1-passage-01-p01-s09",
              "sentenceOrder": 9,
              "text": "Some researchers propose that turbulence within the gas clouds might prevent the gas from collapsing to form stars."
            }
          ]
        },
        {
          "paragraphId": "reading-rap-b58232c37a080aa5aad5e9d1-passage-01-p02",
          "paragraphOrder": 2,
          "text": "Observations from the Hubble Space Telescope and other UV-sensitive instruments have revealed that dark galaxies were more common in the early universe. These findings suggest that dark galaxies may represent a primordial phase in galaxy evolution. One hypothesis is that high levels of UV radiation in the early universe prevented the gas in dark galaxies from cooling and condensing into stars. Observations of regions with high UV radiation support this theory.",
          "rawText": "Observations from the Hubble Space Telescope and other UV-sensitive instruments have revealed that dark galaxies were more common in the early universe. These findings suggest that dark galaxies may represent a primordial phase in galaxy evolution. One hypothesis is that high levels of UV radiation in the early universe prevented the gas in dark galaxies from cooling and condensing into stars. Observations of regions with high UV radiation support this theory.",
          "sentences": [
            {
              "sentenceId": "reading-rap-b58232c37a080aa5aad5e9d1-passage-01-p02-s01",
              "sentenceOrder": 1,
              "text": "Observations from the Hubble Space Telescope and other UV-sensitive instruments have revealed that dark galaxies were more common in the early universe."
            },
            {
              "sentenceId": "reading-rap-b58232c37a080aa5aad5e9d1-passage-01-p02-s02",
              "sentenceOrder": 2,
              "text": "These findings suggest that dark galaxies may represent a primordial phase in galaxy evolution."
            },
            {
              "sentenceId": "reading-rap-b58232c37a080aa5aad5e9d1-passage-01-p02-s03",
              "sentenceOrder": 3,
              "text": "One hypothesis is that high levels of UV radiation in the early universe prevented the gas in dark galaxies from cooling and condensing into stars."
            },
            {
              "sentenceId": "reading-rap-b58232c37a080aa5aad5e9d1-passage-01-p02-s04",
              "sentenceOrder": 4,
              "text": "Observations of regions with high UV radiation support this theory."
            }
          ]
        }
      ]
    }
