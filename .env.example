NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=
OPENROUTER_WRITING_MODEL=
WRITING_REVIEW_PROVIDER=moonshot
MOONSHOT_API_KEY=
MOONSHOT_API_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_WRITING_MODEL=kimi-k3
# C3 is the production default. Set legacy_v22 only for a manual rollback.
# Set to c3 to opt in; C3 uses a 60s hedge and a 120s deadline by default.
WRITING_REVIEW_PIPELINE=c3
# Optional temporary C3 deadline override in milliseconds; must be greater than 60000.
WRITING_REVIEW_C3_DEADLINE_MS=
