NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Server-side R2 publishing credentials. Never expose these through NEXT_PUBLIC_*.
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public browser-readable custom domain or temporary *.r2.dev base URL.
# Runtime URLs are resolved server-side and passed to clients; this is not stored in Supabase.
READING_ASSET_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_WRITING_MODEL=
WRITING_REVIEW_PROVIDER=moonshot
MOONSHOT_API_KEY=
MOONSHOT_API_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_WRITING_MODEL=kimi-k3
# Explicit test/rollback option: set WRITING_REVIEW_PROVIDER=deepseek_flash.
# The production default remains Moonshot unless this is selected manually.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_WRITING_MODEL=deepseek-v4-flash
# C3 is the production default. Set legacy_v22 only for a manual rollback.
# C3 uses a 90s hedge and a 210s overall deadline by default.
WRITING_REVIEW_PIPELINE=c3
# Optional override. Values below 210000 are ignored so a hedge started at 90s
# always retains a full 120s request window.
WRITING_REVIEW_C3_DEADLINE_MS=
